# Copiá este archivo a `.env` para cambiar puertos o credenciales del entorno
# local. Sin `.env`, el compose usa estos mismos valores por defecto.

# --- Puertos expuestos al host ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
# El 5432 del host suele estar tomado por un PostgreSQL instalado a mano,
# por eso la base del compose se publica en 5433.
POSTGRES_PORT=5433

# --- Base de datos ---
# Debe coincidir con DATABASE_URL que arma docker-compose.yml.
POSTGRES_USER=proptech
POSTGRES_PASSWORD=proptech
POSTGRES_DB=proptech

# --- Cuentas sembradas al primer arranque ---
# El admin no se puede autorregistrar: se crea acá (o con ADMIN_*).
ADMIN_EMAIL=admin@proptech.local
ADMIN_PASSWORD=admin12345
# Propietario demo: gestiona los inmuebles 101-104 de la semilla.
OWNER_EMAIL=dueno@proptech.local
OWNER_PASSWORD=dueno12345
# Agente demo: gestiona la cartera 104-106.
AGENT_EMAIL=agente@proptech.local
AGENT_PASSWORD=agente12345
# Inquilino demo: trae perfil y feedback sembrados (favoritos, "me gusta",
# "no me gusta", interacciones) para probar /recommend y las métricas reales.
SEEKER_EMAIL=buscador@proptech.local
SEEKER_PASSWORD=buscador12345
